# Example only: the server does not automatically load this file.
MINTTOWN_LIVE=0
MINTTOWN_FRAUD_LIVE=0
# Leave MINTTOWN_DAILY_CALLS unset; admission follows the dollar limits below.
MINTTOWN_DAILY_USD=2.00
MINTTOWN_TOTAL_USD=8.00
# Vertex AI uses local Application Default Credentials when explicitly enabled.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Optional legacy Gemini Developer API adapter; never commit a real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
